#!/bin/sh
# Revia: 手元から main/master への push を拒否する。反映は PR の squash merge だけ。
# fast-forward merge や cherry-pick は commit 時の hook を通らないため、ここが最後の砦。
# 標準入力: <local ref> <local sha> <remote ref> <remote sha>
zero=0000000000000000000000000000000000000000
status=0
while read -r lref lsha rref rsha; do
  case "$rref" in
    refs/heads/main|refs/heads/master) ;;
    *) continue ;;
  esac
  [ "$lsha" = "$zero" ] && continue   # branch 削除は対象外
  echo "pre-push: $rref への push は禁止です。branch を push して PR を作り、squash merge で反映してください（AGENTS.md「Git の進め方」）。" >&2
  echo "  緊急時に人間が回避する場合のみ: git push --no-verify（AI は使わない）" >&2
  status=1
done
exit $status
