/sample-data/private/
*.private.json

# ビルド成果物
build/
app/build/
.gradle/
local.properties
*.apk
*.aab

# IDE
.idea/
*.iml
.DS_Store

# Kotlin コンパイラのセッション情報
.kotlin/

