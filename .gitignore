# 署名鍵とパスワード。絶対にコミットしない（このリポジトリは公開）
keystore/
keystore.properties
*.jks
*.keystore

# API キーなどの秘密情報。公開リポジトリには 1 件も置かない
.secrets/
.env
.env.*
!.env.example

